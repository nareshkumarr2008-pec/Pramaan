PORT=4000
JWT_SECRET=change-this-to-a-long-random-string

# --- AI provider ---
# "cloud" (default) uses Anthropic's API below.
# "local" uses your own fine-tuned model served via Ollama — see ai-engine/README.md.
AI_PROVIDER=local

# Used when AI_PROVIDER=cloud
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Used when AI_PROVIDER=local
LOCAL_AI_URL=http://localhost:11434
LOCAL_AI_MODEL=setu-ai

# Set to "true" to log every (prompt, response) pair to backend/data/training_log.jsonl
# while running on AI_PROVIDER=cloud, so you build real training data for your own
# model over time. Safe to leave on permanently.
LOG_TRAINING_DATA=false
